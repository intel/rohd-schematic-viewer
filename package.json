{
  "name": "rohd-schematic-viewer",
  "displayName": "ROHD Schematic Viewer",
  "description": "Visualize Yosys JSON netlist files as interactive schematics",
  "version": "0.3.0",
  "license": "BSD-3-Clause",
  "publisher": "intel-corporation",
  "repository": {
    "type": "git",
    "url": "https://github.com/intel/rohd-schematic-viewer.git"
  },
  "icon": "icon.png",
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:vscodeSchematicViewer.openSchematic",
    "onCommand:vscodeSchematicViewer.openDartAsSchematic",
    "onCustomEditor:vscodeSchematicViewer.yosysJson"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscodeSchematicViewer.yosysJson",
        "displayName": "ROHD Schematic Viewer",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "vscodeSchematicViewer.openSchematic",
        "title": "Open as Schematic",
        "category": "VSCode"
      },
      {
        "command": "vscodeSchematicViewer.openDartAsSchematic",
        "title": "Open Dart As Schematic (dart -> .json)",
        "category": "VSCode"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vscodeSchematicViewer.openSchematic",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "vscodeSchematicViewer.openDartAsSchematic",
          "when": "resourceExtname == .dart",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ROHD Schematic Viewer",
      "properties": {}
    }
  },
  "scripts": {
    "build:extension": "make extension",
    "test:vsix": "node scripts/test_extension_vsix.cjs",
    "test:indexed-file": "node --test scripts/test_indexed_file.cjs",
    "install:server": "sh ./scripts/install_extension_server.sh build/rohd-schematic-viewer-*.vsix",
    "clean:builds": "sh ./scripts/clean_builds.sh"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
