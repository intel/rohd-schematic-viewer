{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure ROHD Dependency",
            "type": "shell",
            "command": "bash scripts/schematic_dev_mode.sh configure-group rohd ${input:rohdSource} && flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdSourceValue}",
                    "ROHD_LOCAL_PATH": "${input:rohdSourceValue}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted, Git, or local for rohd."
        },
        {
            "label": "Configure Package Dependency",
            "type": "shell",
            "command": "bash scripts/schematic_dev_mode.sh configure-group package ${input:packageSource} && flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdSourceValue}",
                    "ROHD_LOCAL_PATH": "${input:rohdSourceValue}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted, Git, or local for rohd_hierarchy and rohd_source_navigator."
        },
        {
            "label": "Configure Widget Dependency",
            "type": "shell",
            "command": "bash scripts/schematic_dev_mode.sh configure-group widget ${input:widgetSource} && flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdSourceValue}",
                    "ROHD_LOCAL_PATH": "${input:rohdSourceValue}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted, Git, or local for all three companion packages."
        },
        {
            "label": "Configure All Dependencies",
            "type": "shell",
            "command": "bash scripts/schematic_dev_mode.sh configure-group all ${input:allDependencySource} && flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdSourceValue}",
                    "ROHD_LOCAL_PATH": "${input:rohdSourceValue}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted, Git, or local for every ROHD-related dependency."
        },
        {
            "label": "ROHD Schematic Viewer: Web Debug",
            "type": "shell",
            "command": "flutter pub get && bash scripts/schematic_run.sh web-debug",
            "isBackground": true,
            "problemMatcher": {"pattern": {"regexp": "^$"}, "background": {"activeOnStart": true, "beginsPattern": "^Launching", "endsPattern": "is being served at"}},
            "presentation": {"reveal": "always", "panel": "dedicated", "focus": true}
        },
        {
            "label": "ROHD Schematic Viewer: Web Release WASM",
            "type": "shell",
            "command": "flutter pub get && bash scripts/schematic_run.sh web-release",
            "isBackground": true,
            "problemMatcher": {"pattern": {"regexp": "^$"}, "background": {"activeOnStart": true, "beginsPattern": "^Launching", "endsPattern": "is being served at"}},
            "presentation": {"reveal": "always", "panel": "dedicated", "focus": true}
        },
        {
            "label": "ROHD Schematic Viewer: Linux Debug",
            "type": "shell",
            "command": "flutter pub get && bash scripts/schematic_run.sh linux-debug",
            "isBackground": true,
            "problemMatcher": {"pattern": {"regexp": "^$"}, "background": {"activeOnStart": true, "beginsPattern": "^Running Flutter", "endsPattern": "^Application finished"}},
            "presentation": {"reveal": "always", "panel": "dedicated", "focus": true}
        },
        {
            "label": "ROHD Schematic Viewer: Linux Release",
            "type": "shell",
            "command": "flutter pub get && bash scripts/schematic_run.sh linux-release",
            "isBackground": true,
            "problemMatcher": {"pattern": {"regexp": "^$"}, "background": {"activeOnStart": true, "beginsPattern": "^Running Flutter", "endsPattern": "^Application finished"}},
            "presentation": {"reveal": "always", "panel": "dedicated", "focus": true}
        }
    ],
    "inputs": [
        {
            "id": "rohdSource",
            "type": "pickString",
            "description": "Source for rohd",
            "options": ["hosted", "git", "local"],
            "default": "hosted"
        },
        {
            "id": "packageSource",
            "type": "pickString",
            "description": "Source for rohd_hierarchy and rohd_source_navigator",
            "options": ["hosted", "git", "local"],
            "default": "hosted"
        },
        {
            "id": "widgetSource",
            "type": "pickString",
            "description": "Source for rohd_hierarchy, rohd_devtools_widgets, and rohd_source_navigator",
            "options": ["hosted", "git", "local"],
            "default": "hosted"
        },
        {
            "id": "allDependencySource",
            "type": "pickString",
            "description": "Source for every ROHD-related dependency",
            "options": ["hosted", "git", "local"],
            "default": "hosted"
        },
        {
            "id": "rohdSourceValue",
            "type": "promptString",
            "description": "Git ref or local ROHD checkout path (leave blank for the default)",
            "default": ""
        }
    ]
}
